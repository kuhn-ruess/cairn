# bktodo configuration. Copy to .env, fill in, restart the app.
# Flask reads anything prefixed with BKTODO_ into app.config[<rest>].

# ---- Core ----
BKTODO_SECRET_KEY=change-me-to-something-long-and-random
# Use application.config.ProdConfig in production
BKTODO_CONFIG=application.config.DevConfig

# ---- MongoDB ----
BKTODO_MONGO_HOST=localhost
BKTODO_MONGO_PORT=27017
BKTODO_MONGO_DB=bktodo
# Leave empty if your MongoDB doesn't require auth
BKTODO_MONGO_USER=
BKTODO_MONGO_PASSWORD=
BKTODO_MONGO_AUTH_SOURCE=

# ---- Redis / background workers (Celery) ----
# Broker + result backend for the distributed Zammad auto-sync. In Docker
# Compose this is the bundled redis service. The worker + beat containers
# read the same value.
BKTODO_REDIS_URL=redis://redis:6379/0
# How stale a user's last Zammad sync may get before beat re-enqueues them.
BKTODO_ZAMMAD_SYNC_INTERVAL_MIN=5
# The notes mirror (notes as Markdown files on a WebDAV share) refuses private
# addresses like every other user-supplied URL here. Set this to 1 if the share
# is on your LAN or behind a VPN — it lets a user aim the mirror at an internal
# address, so only turn it on for a deployment you control.
# BKTODO_MIRROR_ALLOW_PRIVATE=1

# ---- Brute-force limits (per client IP) ----
# The two login limits count FAILED attempts only, so a working client is
# never throttled. Counters live in Redis above so they're shared across
# workers; without Redis they fall back to weaker per-worker counts.
# Uncomment to override the defaults shown here.
#BKTODO_RATELIMIT_LOGIN=10 per 15 minutes
#BKTODO_RATELIMIT_CALDAV=20 per 15 minutes
#BKTODO_RATELIMIT_PASSWORD_RESET=5 per hour
#BKTODO_RATELIMIT_RESET_CONFIRM=10 per hour
#BKTODO_RATELIMIT_REGISTER=5 per hour
# Set to 0 to switch the limiter off entirely (not recommended).
#BKTODO_RATELIMIT_ENABLED=1

# ---- Local timezone ----
# IANA timezone name used when pushing tasks to Google Calendar.
# The datetime-local form input has no offset, so this is how Cairn
# tells Google how to interpret the wall-clock value. Example:
#   BKTODO_DEFAULT_TZ=Europe/Berlin
BKTODO_DEFAULT_TZ=UTC

# ---- Google Calendar OAuth (one app for the whole deployment) ----
# Register a single OAuth 2.0 client in Google Cloud Console, type
# "Web application". The redirect URI to whitelist is:
#   <your-bktodo-base-url>/settings/calendars/google/callback
# Then drop the values here. All users on this bktodo instance share
# this OAuth client — they never see it, they just click "Connect".
BKTODO_GOOGLE_CLIENT_ID=
BKTODO_GOOGLE_CLIENT_SECRET=

# ---- Microsoft Teams meetings for the booking page ----
# One Entra app registration for the whole deployment; each user then clicks
# "Connect Microsoft" under Settings → Booking page. To register it:
#
#   1. entra.microsoft.com → Applications → App registrations → New
#   2. Supported account types: "Accounts in any organizational directory"
#      (a PERSONAL Microsoft account cannot host a Teams meeting, which is
#      why BKTODO_MS_TENANT stays "organizations")
#   3. Redirect URI, platform "Web":
#        https://<your-host>/settings/booking/microsoft/callback
#      (locally: http://localhost:5004/settings/booking/microsoft/callback)
#   4. API permissions → Microsoft Graph → DELEGATED:
#        OnlineMeetings.ReadWrite, User.Read, offline_access
#      "Grant admin consent" if your tenant requires it
#   5. Certificates & secrets → New client secret → copy the VALUE
#      (not the Secret ID) into BKTODO_MS_CLIENT_SECRET
#
# The connecting account needs a Teams licence, otherwise Graph answers 403
# and the booking records "no meeting link".
BKTODO_MS_CLIENT_ID=
BKTODO_MS_CLIENT_SECRET=
BKTODO_MS_TENANT=organizations

# ---- SMTP (password resets, booking confirmations) ----
# An EMPTY BKTODO_SMTP_HOST switches mail off entirely — no error anywhere,
# just nothing sent. That is the usual reason "mails don't go out". Set the
# four values below, restart, and check with:
#
#   ./helper cairn test-mail you@example.com      (docker)
#   ./cairn test-mail you@example.com             (venv)
#
# which prints the settings it resolved and the server's actual answer.
#
# Encryption: port 587 = STARTTLS (the default), port 465 = implicit TLS,
# recognised from the port alone. Force it either way with BKTODO_SMTP_SSL
# (1/0); getting it wrong is a timeout, not an error message.
BKTODO_SMTP_HOST=
BKTODO_SMTP_PORT=587
BKTODO_SMTP_USER=
BKTODO_SMTP_PASSWORD=
# The visible sender. Many providers refuse a From that isn't the mailbox you
# logged in with. Defaults to BKTODO_SMTP_USER.
BKTODO_SMTP_FROM=
BKTODO_SMTP_TLS=1
BKTODO_SMTP_SSL=

# ---- Subscriptions ----
# Off (the default) means: no plans, no trial, no free tier and no sign-up
# form — people are invited, and everyone is premium. Set it to 1 to run the
# commercial model; only then does anything under Stripe below apply.
BKTODO_SUBSCRIPTIONS_ENABLED=

# ---- Stripe subscription billing ----
# Leave STRIPE_SECRET_KEY empty to disable billing (the /billing page then
# says it isn't configured). Webhook endpoint to register in Stripe:
#   <base-url>/billing/webhook
# (events: checkout.session.completed, customer.subscription.created/updated/deleted)
BKTODO_STRIPE_SECRET_KEY=
BKTODO_STRIPE_PUBLISHABLE_KEY=
BKTODO_STRIPE_WEBHOOK_SECRET=
# Recurring prices (create them in the Stripe dashboard, paste the price ids):
#   PREMIUM     — €2/mo solo (licensed, qty 1)
#   SEAT_ORG    — €5/mo per member seat (organisation teams; quantity)
#   FAMILY_BASE — €5/mo flat, covers the first FAMILY_INCLUDED_SEATS seats
#   SEAT_FAMILY — €2/mo per extra family member seat (quantity)
# The paying admin's subscription carries the seat quantity; their own seat is free.
BKTODO_STRIPE_PRICE_PREMIUM=
BKTODO_STRIPE_PRICE_SEAT_ORG=
BKTODO_STRIPE_PRICE_FAMILY_BASE=
BKTODO_STRIPE_PRICE_SEAT_FAMILY=
BKTODO_FAMILY_INCLUDED_SEATS=5
# Free premium trial length for new signups (days).
BKTODO_TRIAL_DAYS=30
