__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.env
.env.local
*.log
instance/
.pytest_cache/
.coverage
.DS_Store
.idea/
.vscode/
node_modules/

# Pasted note images are stored inline on the item now, not on disk.
# Anything that still lands here (legacy uploads, dev artifacts) is local-only.
application/static/uploads/*
!application/static/uploads/.gitkeep

# Claude Code: memory + local agent config live in the repo, not in git.
.claude/

# Credential material never belongs in the tree — the app takes everything
# through BKTODO_* env vars (see .env.example, which holds names, no values).
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
*.kdbx

# Real exports/dumps used while developing. A single customer CSV that was
# committed by accident is the reason this line exists.
*.csv
!application/static/**/*.csv
